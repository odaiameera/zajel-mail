# ----------------------------------------------------------------------------
# JMAP webmail environment variable template
#
# Copy to `.env.local` and fill in real values for local development:
#     cp .env.example .env.local
#
# `.env.local` is the default env file for local runs (dev / preview / start);
# it is git-ignored and docker-ignored. Production deployments pass these
# through docker-compose `environment:` (see docker-compose.example.yml).
# ----------------------------------------------------------------------------

# REQUIRED. Encrypts linked mail-account passwords at rest (AES-256-GCM).
# Must be 32+ characters. Generate one with: openssl rand -base64 32
# Back it up — rotating it invalidates every linked account's stored password.
WEBMAIL_SECRET=

# RECOMMENDED. Default mail server base URL offered when linking accounts.
# Can be overridden per account in the link form. e.g. https://mx.example.com
JMAP_BASE_URL=

# OPTIONAL. AI mail assistant (Raven) and event extraction. With OPENAI_API_KEY
# set, they run on OpenAI; OPENAI_MODEL defaults to gpt-5.6-terra (gpt-5.6-luna
# is the faster, cheaper tier). The OLLAMA_* settings below are then unused.
OPENAI_API_KEY=
OPENAI_MODEL=

# Without OPENAI_API_KEY: Ollama Cloud (https://ollama.com) or any
# self-hosted Ollama-compatible endpoint.
#
# OLLAMA_MODEL must name a tag the endpoint actually serves. Ollama Cloud
# serves its hosted models under `-cloud` tags (e.g. deepseek-v4-flash:cloud);
# a bare tag resolves only on a self-hosted endpoint that has pulled it.
# A retired or unknown tag makes /api/chat answer 404 or 410, which the agent
# panel reports as the model being unavailable.
#
# Run `npm run ai:models` to print the tags your endpoint serves and check
# OLLAMA_MODEL against them. It exits non-zero if the configured tag is missing.
OLLAMA_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=

# OPTIONAL. Jev, TypeSafe's decision model, sorting new Inbox mail into tabs
# (Settings > Jev). Each account opts in separately; until one does, nothing is
# sent. JEV_MODEL defaults to a pinned version (jev-1.13.0) because confidence
# thresholds are tuned per version. TYPESAFE_BASE_URL routes through a gateway
# such as LiteLLM. JEV_MOCK=1 answers locally, with no key and no network.
TYPESAFE_API_KEY=
JEV_MODEL=
TYPESAFE_BASE_URL=
JEV_MOCK=

# OPTIONAL. Native task apps used only after the user confirms a proposal.
# Todoist adds to Inbox when TODOIST_PROJECT_ID is left blank.
TODOIST_API_TOKEN=
TODOIST_PROJECT_ID=

# Linear requires a destination team. A project is optional.
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=

# Notion requires a shared data source. Its title property is discovered
# automatically. NOTION_DUE_PROPERTY is optional (e.g. Due or Deadline).
NOTION_API_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_DUE_PROPERTY=

# OPTIONAL fallback: generic task API, automation webhook, or MCP-to-HTTP bridge.
TASK_ADAPTER_URL=
TASK_ADAPTER_API_KEY=

# OPTIONAL. SQLite path. Defaults to ./local-data/ameera.db in dev and
# /data/ameera.db in production (NODE_ENV=production).
# DATABASE_PATH=

# OPTIONAL. Event log for something watching the server: one JSON object per
# line (agent turns, AI and Telegram failures, job runs, crashes), never mail
# content. Rolls over to <LOG_FILE>.1 at 10 MB. Off when unset.
# LOG_FILE=./local-data/logs/zajel.log

# REQUIRED IN PRODUCTION (npm start). The public URL the app is served from,
# so SvelteKit's CSRF check accepts login/setup form posts. Not needed for dev.
# ORIGIN=https://webmail.example.com
