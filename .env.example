# ----------------------------------------------------------------------------
# Zajel Mail environment variables
#
# Copy to `.env.local` and fill in real values for local development:
#     cp .env.example .env.local
#
# `.env.local` is the default env file for local runs (dev / preview / start);
# it is git-ignored and docker-ignored. Production deployments pass these
# through docker-compose `environment:` (see docker-compose.example.yml).
# The README's Configuration table describes every one of them.
# ----------------------------------------------------------------------------

# REQUIRED. Encrypts linked mail-account passwords at rest (AES-256-GCM).
# Must be 32+ characters. Generate one with: openssl rand -base64 32
# Back it up: rotating it invalidates every linked account's stored password.
WEBMAIL_SECRET=

# RECOMMENDED. Default mail server base URL offered when linking accounts.
# Can be overridden per account in the link form. e.g. https://mx.example.com
JMAP_BASE_URL=

# REQUIRED IN PRODUCTION (npm start). The public URL the app is served from,
# so SvelteKit's CSRF check accepts login/setup form posts. Not needed for dev.
# ORIGIN=https://webmail.example.com

# BEHIND A REVERSE PROXY. Every request then arrives from the proxy, so
# sign-in limits would count all clients as one. Read the client's address
# from the header the proxy adds; depth 1 trusts only that one proxy.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# OPTIONAL. Read by SvelteKit's Node server. The Docker image sets PORT=3001
# and BODY_SIZE_LIMIT=30M so large attachments upload.
# PORT=3000
# BODY_SIZE_LIMIT=30M

# OPTIONAL. SQLite path. Defaults to ./local-data/ameera.db, or
# /data/ameera.db when NODE_ENV=production (the Docker image sets it).
# DATABASE_PATH=
# NODE_ENV=production

# OPTIONAL. Event log for something watching the server: one JSON object per
# line (agent turns, AI and Telegram failures, job runs, crashes), never mail
# content. Rolls over to <LOG_FILE>.1 at 10 MB. Off when unset.
# LOG_FILE=./local-data/logs/zajel.log

# OPTIONAL. Zajel, the AI mail agent, and event extraction. Hidden when no
# provider is set. When several keys are set, Claude wins, then OpenAI, then
# Ollama, unless AI_PROVIDER names one (claude or anthropic, openai, ollama).
# A provider chosen in Settings > Agent wins over both.
#
# Claude: the agent that acts on your mailbox, with reminders and scheduled
# jobs. ANTHROPIC_MODEL defaults to claude-opus-5-5 (the agent) and
# ANTHROPIC_FAST_MODEL to claude-haiku-5-5 (summaries, drafts, extraction).
# ANTHROPIC_FALLBACK_MODEL (default claude-sonnet-5-5) takes a turn when the
# agent model is overloaded or rate limited.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_FAST_MODEL=
ANTHROPIC_FALLBACK_MODEL=
AI_PROVIDER=

# OpenAI: answers and proposes, but doesn't act. OPENAI_MODEL defaults to
# gpt-5.6-terra (gpt-5.6-luna is the faster, cheaper tier).
OPENAI_API_KEY=
OPENAI_MODEL=

# Ollama Cloud (https://ollama.com) or any self-hosted Ollama-compatible
# endpoint. OLLAMA_MODEL must name a tag the endpoint actually serves. Ollama
# Cloud serves its hosted models under `-cloud` tags (e.g.
# deepseek-v4-flash:cloud); a bare tag resolves only on a self-hosted endpoint
# that has pulled it. Settings > Agent lists the tags your endpoint serves.
OLLAMA_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=

# OPTIONAL. Semantic search: embeddings from an Ollama on your own server,
# never OLLAMA_URL, since indexing sends it every message's text. Switch it on
# per account in Settings > Search, which can also set or override these.
# EMBED_MODEL defaults to embeddinggemma-2:270m; changing it rebuilds the
# index. The two prefixes set the retrieval prompts for a model Zajel has none
# built in for; set even empty, they replace the built-in ones, so leave them
# commented out unless you need them.
EMBED_URL=
EMBED_MODEL=
# EMBED_QUERY_PREFIX=
# EMBED_DOCUMENT_PREFIX=

# OPTIONAL. Zajel's Telegram bot, from @BotFather. Link your chat in
# Settings > Notifications.
TELEGRAM_BOT_TOKEN=

# OPTIONAL. Contact address for Web Push, a mailto: or https: URL.
# VAPID_SUBJECT=mailto:you@example.com

# OPTIONAL. Jev, TypeSafe's decision model, sorting new Inbox mail into tabs
# (Settings > Jev). Each account opts in separately; until one does, nothing is
# sent. JEV_MODEL defaults to a pinned version (jev-1.13.0) because confidence
# thresholds are tuned per version. TYPESAFE_BASE_URL routes through a gateway
# such as LiteLLM. JEV_MOCK=1 answers locally, with no key and no network.
TYPESAFE_API_KEY=
JEV_MODEL=
TYPESAFE_BASE_URL=
JEV_MOCK=

# OPTIONAL. Where task proposals go (OpenAI and Ollama), only after you
# confirm one. Todoist adds to Inbox when TODOIST_PROJECT_ID is left blank.
TODOIST_API_TOKEN=
TODOIST_PROJECT_ID=

# Linear requires a destination team. A project is optional.
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=

# Notion requires a shared data source. Its title property is discovered
# automatically. NOTION_DUE_PROPERTY is optional (e.g. Due or Deadline).
NOTION_API_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_DUE_PROPERTY=

# Generic task API, automation webhook, or MCP-to-HTTP bridge.
TASK_ADAPTER_URL=
TASK_ADAPTER_API_KEY=
