{
	"name": "zajel-mail",
	"private": true,
	"version": "0.5.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env.local build/index.js",
		"ai:models": "node --env-file-if-exists=.env.local scripts/ai-models.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ics": "npx esbuild src/lib/server/calendar/ics.ts --bundle --platform=node --format=esm --outfile=.test-build/ics.mjs && node tests/ics-qa.mjs",
		"test:caldav": "npx esbuild src/lib/server/calendar/caldav.ts --bundle --platform=node --format=esm --outfile=.test-build/caldav.mjs && node tests/caldav-discovery.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@testing-library/svelte": "^5.4.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.6.0",
		"@types/node-cron": "^3.0.11",
		"@types/papaparse": "^5.5.2",
		"@types/sanitize-html": "^2.16.1",
		"@types/web-push": "^3.6.4",
		"jsdom": "29.0.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@fontsource-variable/cairo": "^5.2.7",
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "1.56.0",
		"@simplewebauthn/browser": "^13.3.0",
		"@simplewebauthn/server": "^13.3.1",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-color": "^3.32.0",
		"@tiptap/extension-font-family": "^3.32.0",
		"@tiptap/extension-highlight": "^3.32.0",
		"@tiptap/extension-image": "^3.32.0",
		"@tiptap/extension-link": "^3.32.0",
